---
import { result, vsLabel, shortDate, type Game } from '../lib/data';
interface Props {
  game: Game;
}
const { game } = Astro.props;
const r = result(game);
---

<a class="game-row" href={`/games/${game.id}/`}>
  <span class="meta date">{shortDate(game.data.date)}</span>
  <span class="opp">
    {vsLabel(game)}
    {game.data.draft && <span class="draft">Draft</span>}
  </span>
  <span class={`res ${r?.win ? 'win' : r ? 'loss' : ''}`}>{r?.text ?? 'Upcoming'}</span>
  {game.data.headline && <span class="headline">{game.data.headline}</span>}
</a>

<style>
  .game-row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    gap: 0.15rem 0.9rem;
    align-items: baseline;
    padding: 0.85rem 0.25rem;
    border-bottom: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
  }
  .game-row:hover .opp {
    color: var(--cardinal);
  }
  .opp {
    font-family: var(--condensed);
    font-weight: 700;
    font-size: 1.2rem;
  }
  .res {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.25rem;
    font-variant-numeric: tabular-nums;
  }
  .res.win {
    color: var(--better);
  }
  .res.loss {
    color: var(--cardinal);
  }
  .headline {
    grid-column: 2 / -1;
    color: var(--muted);
  }
  .draft {
    font-size: 0.8rem;
    background: var(--gold);
    color: var(--cardinal-dark);
    padding: 0.05rem 0.35rem;
    border-radius: 3px;
    margin-left: 0.5rem;
    vertical-align: middle;
  }
</style>
